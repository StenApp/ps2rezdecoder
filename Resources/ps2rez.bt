typedef struct
{
    uint firstDummy;
    uint totalFiles;
    uint secondDummy;
    uint dataOffset;
    uint totalBlocks;
} RezHeader;

typedef struct
{
    uint nameCRC;
    uint offset;
    uint size;
    uint xSize;
} FileData;

RezHeader hdr;

local int i;
local int tableStart;

for (i = 0; i < hdr.totalBlocks; i++)
{
    tableStart = 0x800 + i * 0x19000;

    FSeek(tableStart);

    struct
    {
        FileData entries[hdr.totalFiles];
    } table;
}
